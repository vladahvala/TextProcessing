cabal-version: 3.0
name: text-processing
version: 0.1.0.0
build-type: Simple

executable text-processing
    main-is: Main.hs
    other-modules:
        TextTypes
        TextParser
    build-depends:
        base >=4.14 && <5
    default-language: Haskell2010
    ghc-options:
        -Wall
        -rtsopts
